---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PublicationCard from '../../components/PublicationCard.astro';
import { publications, type PublicationStatus } from '../../data/publications';

const statusOrder: Record<PublicationStatus, number> = {
  Published: 0,
  'In press': 1,
  'Under review': 2,
  Preprint: 3,
  Accepted: 4,
};
const records = [...publications].sort((a, b) => statusOrder[a.status] - statusOrder[b.status]);
const filterOptions = ['All', 'Published', 'In press', 'Under review', 'Preprint'] as const;
const slug = (status: string) => status.toLowerCase().replaceAll(' ', '-');
const countFor = (status: string) => status === 'All' ? records.length : records.filter((record) => record.status === status).length;
---

<BaseLayout
  title="Publications | M.M. Golam Hafiz"
  description="Published, in-press, under-review, and preprint research by M.M. Golam Hafiz in trustworthy medical AI, federated learning, and clinical robustness."
>
  <header class="page-hero publication-index-hero">
    <div class="shell">
      <p class="page-kicker mono">Publications · updated November 2026</p>
      <h1>Publications and current work.</h1>
      <p>{records.length} journal articles, conference papers, preprints, and projects currently in peer review.</p>
      <dl class="record-summary" aria-label="Publication status summary">
        <div><dt>Published</dt><dd>{countFor('Published')}</dd></div>
        <div><dt>In press</dt><dd>{countFor('In press')}</dd></div>
        <div><dt>Under review</dt><dd>{countFor('Under review')}</dd></div>
        <div><dt>Public preprint</dt><dd>{countFor('Preprint')}</dd></div>
      </dl>
    </div>
  </header>

  <section class="section publication-ledger-section" aria-labelledby="publication-ledger-title">
    <div class="shell">
      <div class="ledger-toolbar">
        <div>
          <h2 id="publication-ledger-title">All publications</h2>
          <p id="filter-result" aria-live="polite">Showing all {records.length} publications.</p>
        </div>
        <div class="publication-filters" role="group" aria-label="Filter publications by status">
          {filterOptions.map((option) => (
            <button
              type="button"
              class="filter-button"
              data-publication-filter={slug(option)}
              aria-pressed={option === 'All' ? 'true' : 'false'}
              aria-controls="publication-records"
            >
              <span>{option}</span><span class="mono">{countFor(option)}</span>
            </button>
          ))}
        </div>
      </div>

      <div id="publication-records" class="publication-list publication-ledger">
        {records.map((publication, index) => (
          <div data-publication-record data-status={slug(publication.status)}>
            <PublicationCard publication={publication} index={index} />
          </div>
        ))}
      </div>
    </div>
  </section>

  <script>
    const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-publication-filter]'));
    const records = Array.from(document.querySelectorAll<HTMLElement>('[data-publication-record]'));
    const result = document.querySelector<HTMLElement>('#filter-result');

    const applyFilter = (filter: string, updateUrl = true) => {
      let visible = 0;
      records.forEach((record) => {
        const show = filter === 'all' || record.dataset.status === filter;
        record.hidden = !show;
        if (show) visible += 1;
      });
      buttons.forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.publicationFilter === filter)));
      if (result) result.textContent = filter === 'all' ? `Showing all ${visible} publications.` : `Showing ${visible} ${filter.replace('-', ' ')} publications.`;
      if (updateUrl) {
        const url = new URL(window.location.href);
        if (filter === 'all') url.searchParams.delete('status');
        else url.searchParams.set('status', filter);
        history.replaceState({}, '', url);
      }
    };

    buttons.forEach((button) => button.addEventListener('click', () => applyFilter(button.dataset.publicationFilter ?? 'all')));
    const requested = new URL(window.location.href).searchParams.get('status') ?? 'all';
    const valid = buttons.some((button) => button.dataset.publicationFilter === requested);
    applyFilter(valid ? requested : 'all', false);
  </script>
</BaseLayout>
