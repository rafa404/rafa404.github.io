---
import BaseLayout from '../layouts/BaseLayout.astro';
import PublicationCard from '../components/PublicationCard.astro';
import { experience, education, expertise } from '../data/site';
import { publications } from '../data/publications';

const statusOrder = { Published: 0, 'In press': 1, 'Under review': 2, Preprint: 3, Accepted: 4 } as const;
const publicResearch = [...publications].sort((a, b) => statusOrder[a.status] - statusOrder[b.status]);
---

<BaseLayout
  title="Curriculum Vitae | M.M. Golam Hafiz"
  description="Professional CV for AI/ML researcher M.M. Golam Hafiz, covering research experience, education, technical expertise, and publications."
>
  <header class="page-hero">
    <div class="shell">
      <h1>Curriculum Vitae</h1>
      <p>Research experience, education, technical expertise, and publications.</p>
    </div>
  </header>

  <section class="section" aria-labelledby="experience-title">
    <div class="shell">
      <div class="section-heading"><h2 id="experience-title">Experience</h2><p>Research, teaching, and professional roles.</p></div>
      <div class="timeline">
        {experience.map((item) => (
          <article class="timeline-row">
            <div class="timeline-period mono">{item.period}</div>
            <div><h3>{item.role} · {item.organization}</h3><p>{item.detail}</p></div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-rule" aria-labelledby="education-title">
    <div class="shell">
      <div class="section-heading"><h2 id="education-title">Education</h2><p>Academic background and qualifications.</p></div>
      <div class="timeline">
        {education.map((item) => (
          <article class="timeline-row">
            <div class="timeline-period mono">{item.period}</div>
            <div><h3>{item.degree}</h3><p>{item.institution} · {item.result}</p></div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-rule" aria-labelledby="expertise-title">
    <div class="shell">
      <div class="section-heading"><h2 id="expertise-title">Technical Expertise</h2><p>Tools and methods used across research, modelling, and evaluation.</p></div>
      <dl class="expertise-list">
        {expertise.map(([term, detail]) => <div class="expertise-row"><dt>{term}</dt><dd>{detail}</dd></div>)}
      </dl>
    </div>
  </section>

  <section class="section section-rule" aria-labelledby="cv-publications-title">
    <div class="shell">
      <div class="section-heading"><h2 id="cv-publications-title">Publications</h2><p>Journal articles, conference papers, preprints, and work currently in peer review.</p></div>
      <div class="publication-list">
        {publicResearch.map((publication, index) => <PublicationCard publication={publication} index={index} />)}
      </div>
    </div>
  </section>
</BaseLayout>
