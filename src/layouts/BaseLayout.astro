---
import Seo from '@jdevalk/astro-seo-graph/Seo.astro';
import '@fontsource-variable/literata';
import '@fontsource-variable/schibsted-grotesk';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';

interface Props {
  title: string;
  description: string;
  image?: string;
  ogType?: 'website' | 'article' | 'profile';
  graph?: Record<string, unknown>;
  article?: {
    publishedTime?: string;
    authors?: string[];
    tags?: string[];
    section?: string;
  };
  noindex?: boolean;
}

const {
  title,
  description,
  image = `${site.url}/og.jpg`,
  ogType = 'website',
  graph,
  article,
  noindex = false,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f4f6f3" />
    <Seo
      title={title}
      description={description}
      canonical={Astro.url}
      ogType={ogType}
      ogImage={image}
      ogImageAlt={`${site.name} academic research portfolio`}
      ogImageWidth={1200}
      ogImageHeight={675}
      siteName={`${site.name} Research`}
      author={site.name}
      graph={graph}
      article={article}
      noindex={noindex}
      extraLinks={[
        { rel: 'icon', type: 'image/svg+xml', href: '/favicon.svg' },
        { rel: 'sitemap', href: '/sitemap-index.xml' },
        { rel: 'alternate', type: 'application/rss+xml', title: `${site.name} publications`, href: '/feed.xml' },
      ]}
    />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <Header />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
  </body>
</html>
