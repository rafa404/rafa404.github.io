---
import ExternalIcon from './ExternalIcon.astro';
import { site } from '../data/site';
---

<footer class="site-footer">
  <div class="shell footer-grid">
    <div>
      <p class="footer-name">{site.name}</p>
      <p class="footer-note">Verified public records and author-approved review-stage metadata. Manuscript files, drafts, and anonymous submissions remain private.</p>
    </div>
    <div class="footer-links" aria-label="External profiles">
      <a href={site.github} target="_blank" rel="noopener noreferrer">GitHub <ExternalIcon /></a>
      <a href={site.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn <ExternalIcon /></a>
      <a href={site.scholar} target="_blank" rel="noopener noreferrer">Google Scholar <ExternalIcon /></a>
    </div>
    <p class="footer-meta"><span class="mono">Dhaka · UTC+6</span><br />Research record reviewed November 2026</p>
  </div>
</footer>
